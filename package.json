{
  "name": "@home-teacher/common",
  "version": "0.1.0",
  "private": false,
  "description": "Shared components, hooks, and utilities for TutoTuto/DoriDori apps",
  "type": "module",
  "scripts": {
    "test": "npm run test:i18n && node --test tests/auth-context.test.cjs tests/on-demand-loading.test.cjs tests/deferred-assets.test.mjs tests/wheel-page-navigation.test.cjs tests/wheel-panel-navigation.test.cjs tests/study-trace-deletion.test.cjs tests/study-trace-undo.test.cjs tests/study-toolbar.test.cjs tests/study-hooks.test.cjs",
    "test:i18n": "node build/checkTranslations.mjs src && node --test tests/localization.test.cjs",
    "test:auth": "node --test tests/auth-context.test.cjs"
  },
  "exports": {
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./utils/*": "./src/utils/*",
    "./services/*": "./src/services/*",
    "./contexts/*": "./src/contexts/*",
    "./lib/*": "./src/lib/*",
    "./constants/*": "./src/constants/*",
    "./types/*": "./src/types/*",
    "./i18n/*": "./src/i18n/*"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "fabric": "^5.3.0",
    "firebase": "^12.10.0",
    "heic2any": "^0.0.4",
    "i18next": "^25.7.4",
    "jspdf": "^3.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.2",
    "react-icons": "^5.5.0",
    "simple-icons": "^15.19.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3"
  }
}
